# Copy this file to .env and change the secret and admin password.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
FLASK_DEBUG=false
DATABASE_PATH=candidates.db

# Optional SMTP email settings (Gmail example: smtp.gmail.com, port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
EMAIL_FROM=your-email@gmail.com

# Optional fallback Meet URL for manually scheduled reviews
DEFAULT_MEET_LINK=

# Optional AI key for future AI feature integration
OPENAI_API_KEY=
